# LLM Provider — choose one
# Option A: Ollama (local, zero cost)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1

# Option B: OpenAI
OPENAI_API_KEY=sk-...

# Option C: Anthropic
ANTHROPIC_API_KEY=sk-ant-...

# Active provider: "ollama" | "openai" | "anthropic"
LLM_PROVIDER=ollama

# Vector Store: "faiss" | "chroma"
VECTOR_STORE_TYPE=faiss
VECTOR_STORE_PATH=./data/vectorstore

# Embeddings model (sentence-transformers hub id)
EMBEDDINGS_MODEL=all-MiniLM-L6-v2

# SEC EDGAR downloader
SEC_USER_AGENT=YourName your@email.com

# yfinance — no key needed, but rate limiting applies

# AWS (for deployment)
AWS_REGION=us-east-1
S3_BUCKET_NAME=financial-research-assistant

# API
API_HOST=0.0.0.0
API_PORT=8000
LOG_LEVEL=INFO
